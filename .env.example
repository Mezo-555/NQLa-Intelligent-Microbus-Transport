# Local development only. Replace JWT_SECRET_KEY with a unique random value.
POSTGRES_DB=nqla
POSTGRES_USER=nqla
POSTGRES_PASSWORD=local_only_change_me
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nqla:local_only_change_me@db:5432/nqla
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
DRIVER_LOCATION_MAX_AGE_SECONDS=120
MATCHING_RADIUS_METERS=5000
MATCHING_AVERAGE_SPEED_KMH=20
MATCHING_WEIGHTS_PROXIMITY=0.45
MATCHING_WEIGHTS_ETA=0.25
MATCHING_WEIGHTS_ROUTE_COMPATIBILITY=0.30
CORS_ORIGINS=*
